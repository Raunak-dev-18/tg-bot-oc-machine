# Copy these into your environment (do NOT commit real secrets).
TELEGRAM_BOT_TOKEN=
# Optional: comma/space-separated allowlist — numeric IDs and/or @usernames.
# Empty = open to anyone (NOT recommended). Example: TELEGRAM_ALLOWED_USERS=@raunak_asusual
TELEGRAM_ALLOWED_USERS=
# Machine directory opencode operates in (defaults to workspace root).
WORK_DIR=/home/runner/workspace
DATA_DIR=/home/runner/workspace/artifacts/tg-control-bot/data
# Files the agent saves for you (screenshots, reports) land here and are
# delivered to Telegram automatically. Inbox = your uploads to the agent.
OUTBOX_DIR=/home/runner/workspace/artifacts/tg-control-bot/data/outbox
# Isolated opencode config home (browser MCP etc.). Leave default.
OPENCODE_CONFIG_HOME=/home/runner/workspace/artifacts/tg-control-bot/data/.opencode-home
# Browser used by the agent's Playwright MCP (headless Chromium).
CHROMIUM_PATH=/repl/tools/bin/chromium
# Drop-in agent skills (SKILL.md guides). Auto-detected next to the package.
# SKILLS_DIR=/path/to/tg-control-bot/skills
# Brain settings
OPENCODE_BIN=opencode
OPENCODE_MODEL=
OPENCODE_AGENT=build
OPENCODE_AUTO_APPROVE=true
OPENCODE_TIMEOUT_MS=600000
# opencode serve integration ("kept running in background"):
# leave AUTO_SERVE=true so the bot starts/manages `opencode serve` itself.
OPENCODE_AUTO_SERVE=true
OPENCODE_SERVE_PORT=4096
# ...or point at an externally managed server instead:
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
TELEGRAM_POLL_TIMEOUT=50
# Voice notes (Sarvam AI): transcription + spoken replies, multilingual.
# Get a key at dashboard.sarvam.ai. Absent = voice notes get a setup hint.
SARVAM_API_KEY=
# Optional TTS tuning (defaults: bulbul:v4-flash + default speaker at pace 1; v2 is deprecated).
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_VOICE=manisha
# SARVAM_PACE=1
# HTTP health endpoint for deployments / uptime pingers (0 = disabled).
# Replit deployments inject PORT automatically.
HEALTH_PORT=5001
